manifest {
    name = 'abhijitswain09/Construction-of-bayesian-network-using-sparsebn-and-bnlearn'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
}
params {
    expression = null
    whitelist = null
    outdir = 'results'
}
process {
    publishDir = [path: params.outdir, mode: 'copy']
    errorStrategy = 'terminate'
    cpus = 4
    memory = '16 GB'
}
profiles {
    standard { process.executor = 'local' }
    conda { conda.enabled = true }
    docker {
        docker.enabled = true
        wave.enabled = true
        wave.strategy = ['conda']
    }
    test { includeConfig 'conf/test.config' }
}
